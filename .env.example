# ─────────────────────────────────────────────────────────────
#  Heritage kiosk — model configuration
#  Copy to .env.local and edit. Every value can also be changed
#  live from the operator dashboard (/admin) except API keys.
# ─────────────────────────────────────────────────────────────

# Startup answer mode: auto | local | online | extractive
#   auto       → try the local model first, fall back to online, then to extractive
#   extractive → no LLM at all; shows the best matching archive passages (works fully offline)
ANSWER_MODE=auto

# ── Local model (Ollama running on the Jetson) ──
LOCAL_BASE_URL=http://127.0.0.1:11434
LOCAL_CHAT_MODEL=llama3.2:3b
# Multilingual embeddings make Hindi/Marathi/Kannada questions match English text.
# Leave empty to use keyword (BM25) search only.
LOCAL_EMBED_MODEL=bge-m3
LOCAL_TIMEOUT_MS=45000

# ── Online model ──
# ONLINE_PROVIDER: openai (any OpenAI-compatible API: OpenAI, Groq, OpenRouter, Together, Gemini's OpenAI endpoint…)
#                  anthropic (Claude Messages API)
ONLINE_PROVIDER=openai
ONLINE_BASE_URL=https://api.openai.com/v1
ONLINE_API_KEY=
# Set this to a model your account can use.
ONLINE_CHAT_MODEL=
ONLINE_TIMEOUT_MS=30000

# ── Voice (optional) ──
# Any OpenAI-compatible speech server. On the Jetson, run a local one (see README) or point at an online API.
# STT_URL  → base URL that serves POST /audio/transcriptions
# TTS_URL  → base URL that serves POST /audio/speech
# Leave empty: the mic button is hidden and read-aloud uses the browser's built-in voice.
STT_URL=
STT_MODEL=Systran/faster-whisper-small
STT_API_KEY=
TTS_URL=
TTS_MODEL=
TTS_VOICE=
TTS_API_KEY=

# Retrieval: passages below this BM25 score are treated as "not in the archive" (cite-or-refuse).
MIN_RETRIEVAL_SCORE=1.5
# With embeddings: cosine similarity needed to count as a match. Tune on your corpus (bge-m3 unrelated text often scores 0.3–0.5).
MIN_VECTOR_SCORE=0.55
TOP_K=5

# Operator dashboard PIN (optional). When set, /admin asks for it before showing controls.
ADMIN_PIN=
