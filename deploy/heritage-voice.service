# On-device voice for the kiosk: Whisper speech-to-text (:8178) and Piper text-to-speech (:8179).
#   sudo cp deploy/heritage-voice.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now heritage-voice
# Edit User= and the paths to match where the project lives (voice/ sits next to samvira/).
[Unit]
Description=Ambedkar Heritage Kiosk voice (Whisper STT + Piper TTS)
After=network.target

[Service]
Type=simple
User=af
ExecStart=/home/af/ambedkar-heritage/voice/start-voice.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
